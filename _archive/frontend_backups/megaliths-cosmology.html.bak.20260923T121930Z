    // ANIMĒTO VIĻŅU / FREKVENČU CANVAS SKRIPTS
    window.addEventListener('DOMContentLoaded', () => {
        const waveCanvas = document.getElementById('frequency-wave-canvas');
        if (waveCanvas) {
            const wCtx = waveCanvas.getContext('2d');
            function resizeWave() {
                waveCanvas.width = waveCanvas.parentElement.clientWidth;
                waveCanvas.height = waveCanvas.parentElement.clientHeight;
            }
            resizeWave();
            window.addEventListener('resize', resizeWave);

            let waveStep = 0;
            function animateWaves() {
                wCtx.fillStyle = 'rgba(2, 6, 23, 0.3)';
                wCtx.fillRect(0, 0, waveCanvas.width, waveCanvas.height);

                const w = waveCanvas.width;
                const h = waveCanvas.height;
                const cy = h / 2;

                wCtx.strokeStyle = 'rgba(245, 158, 11, 0.85)';
                wCtx.lineWidth = 2.5;
                wCtx.beginPath();
                for (let x = 0; x < w; x++) {
                    let y = cy + Math.sin(x * 0.015 + waveStep) * 22;
                    if (x === 0) wCtx.moveTo(x, y);
                    else wCtx.lineTo(x, y);
                }
                wCtx.stroke();

                wCtx.strokeStyle = 'rgba(34, 211, 238, 0.75)';
                wCtx.lineWidth = 1.5;
                wCtx.beginPath();
                for (let x = 0; x < w; x++) {
                    let y = cy + Math.sin(x * 0.08 - waveStep * 1.5) * 12;
                    if (x === 0) wCtx.moveTo(x, y);
                    else wCtx.lineTo(x, y);
                }
                wCtx.stroke();

                waveStep += 0.04;
                requestAnimationFrame(animateWaves);
            }
            animateWaves();
        }
    });

    // 3D Globe Script
    let globeLines = [];
    window.addEventListener('DOMContentLoaded', () => {
        const container = document.getElementById('globe-container');
        if (!container || typeof THREE === 'undefined') return;

        const width = container.clientWidth || 800;
        const height = container.clientHeight || 540;

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
        camera.position.z = 210;

        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setSize(width, height);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        container.appendChild(renderer.domElement);

        const globeGroup = new THREE.Group();
        globeGroup.rotation.y = 0.6;
        scene.add(globeGroup);

        const textureLoader = new THREE.TextureLoader();
        const earthTexture = textureLoader.load('https://cdn.jsdelivr.net/npm/three-globe/example/img/earth-night.jpg', () => {
            renderer.render(scene, camera);
        });

        const sphereGeo = new THREE.SphereGeometry(75, 48, 48);
        const sphereMat = new THREE.MeshBasicMaterial({ map: earthTexture, color: 0xffffff });
        globeGroup.add(new THREE.Mesh(sphereGeo, sphereMat));

        function latLngToVec(lat, lng, radius) {
            const phi = (90 - lat) * (Math.PI / 180);
            const theta = (lng + 180) * (Math.PI / 180);
            return new THREE.Vector3(
                -(radius * Math.sin(phi) * Math.cos(theta)),
                radius * Math.cos(phi),
                radius * Math.sin(phi) * Math.sin(theta)
            );
        }

        const clickableDots = [];
        const siteVectors = [];

        megalithsData.forEach(site => {
            const pos = latLngToVec(site.lat, site.lng, 75.6);
            siteVectors.push(pos);

            const dot = new THREE.Mesh(
                new THREE.SphereGeometry(1.8, 16, 16),
                new THREE.MeshBasicMaterial({ color: site.color })
            );
            dot.position.copy(pos);
            dot.userData = site;
            globeGroup.add(dot);
            clickableDots.push(dot);

            const line = new THREE.Line(
                new THREE.BufferGeometry().setFromPoints([pos, latLngToVec(site.lat, site.lng, 84)]),
                new THREE.LineBasicMaterial({ color: site.color, transparent: true, opacity: 0.85 })
            );
            globeGroup.add(line);
        });

        for (let i = 0; i < siteVectors.length; i++) {
            for (let j = i + 1; j < siteVectors.length; j++) {
                const dist = siteVectors[i].distanceTo(siteVectors[j]);
                if (dist < 90) {
                    const lineGeo = new THREE.BufferGeometry().setFromPoints([siteVectors[i], siteVectors[j]]);
                    const lineMat = new THREE.LineBasicMaterial({ color: 0xfbbf24, transparent: true, opacity: 0.35 });
                    const lMesh = new THREE.Line(lineGeo, lineMat);
                    globeGroup.add(lMesh);
                    globeLines.push(lMesh);
                }
            }
        }

        const raycaster = new THREE.Raycaster();
        const mouse = new THREE.Vector2();
        
        let isInteracting = false;
        let hasMoved = false;
        let prevPos = { x: 0, y: 0 };

        function onStart(x, y) { isInteracting = true; hasMoved = false; prevPos = { x, y }; }
        function onMove(x, y) {
            if (!isInteracting) return;
            const deltaX = x - prevPos.x;
            const deltaY = y - prevPos.y;
            if (Math.abs(deltaX) > 2 || Math.abs(deltaY) > 2) {
                hasMoved = true;
                globeGroup.rotation.y += deltaX * 0.005;
                globeGroup.rotation.x += deltaY * 0.005;
                renderer.render(scene, camera);
            }
            prevPos = { x, y };
        }
        function onEnd() { isInteracting = false; }

        container.addEventListener('mousedown', (e) => onStart(e.clientX, e.clientY));
        window.addEventListener('mouseup', onEnd);
        container.addEventListener('mousemove', (e) => onMove(e.clientX, e.clientY));

        container.addEventListener('touchstart', (e) => {
            if (e.touches.length === 1) {
                onStart(e.touches[0].clientX, e.touches[0].clientY);
            }
        });
        window.addEventListener('touchend', onEnd);
        container.addEventListener('touchmove', (e) => {
            if (e.touches.length === 1) {
                onMove(e.touches[0].clientX, e.touches[0].clientY);
            }
        }, { passive: true });

        container.addEventListener('click', (e) => {
            if (hasMoved) return;
            const rect = renderer.domElement.getBoundingClientRect();
            mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
            mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

            raycaster.setFromCamera(mouse, camera);
            const intersects = raycaster.intersectObjects(clickableDots);

            if (intersects.length > 0) {
                currentSelectedSite = intersects[0].object.userData;
                updateMegalithPopup(currentSelectedSite);
                document.getElementById('megalith-popup').classList.remove('hidden');
            }
        });

        let pulseFrame = 0;
        function renderLoop() {
            requestAnimationFrame(renderLoop);
            pulseFrame += 0.04;
            const pulseOpacity = 0.25 + Math.sin(pulseFrame) * 0.2;
            globeLines.forEach(l => { if (l.material) l.material.opacity = pulseOpacity; });
            renderer.render(scene, camera);
        }
        renderLoop();
    });
