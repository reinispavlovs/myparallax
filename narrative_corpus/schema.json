{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Parallax Narrative Corpus record v0.1 + medical_case extension",
  "type": "object",
  "required": ["id", "source", "account_type", "coding"],
  "properties": {
    "id": {"type": "string"},
    "source": {
      "type": "object",
      "required": ["name", "url", "retrieved_at", "access_status"],
      "properties": {
        "name": {"type": "string"},
        "url": {"type": "string"},
        "retrieved_at": {"type": "string", "format": "date"},
        "published_at": {"type": ["string", "null"]},
        "access_status": {"enum": ["tdm_open", "restricted", "permission_granted", "unknown"]}
      }
    },
    "account_type": {"enum": ["first_hand", "second_hand", "retelling", "interview_transcript"]},
    "event_date": {"type": ["string", "null"]},
    "narrator": {
      "type": "object",
      "properties": {
        "pseudonym_hash": {"type": "string"},
        "medical_context": {"enum": ["cardiac_arrest", "surgery", "accident", "illness", "other", "unknown"]}
      }
    },
    "collection": {
      "type": "object",
      "properties": {
        "solicited": {"type": ["boolean", "null"]},
        "delay_to_report": {"type": ["string", "null"]}
      }
    },
    "text_hash": {"type": "string"},
    "excerpt": {"type": ["string", "null"], "maxLength": 300},
    "duplicates": {
      "type": "object",
      "properties": {
        "cluster_id": {"type": ["string", "null"]},
        "duplicate_of": {"type": ["string", "null"]},
        "method": {"enum": ["exact_text", "near_duplicate", "same_narrator", "retelling", "none"]}
      }
    },
    "motifs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "coder"],
        "properties": {
          "code": {"type": "string"},
          "coder": {"enum": ["llm", "human", "rule"]},
          "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
        }
      }
    },
    "classification": {
      "description": "The source's own classification label and the analysis group derived from it (nde = label NDE only).",
      "type": "object",
      "properties": {"raw": {"type": "string"}, "group": {"enum": ["nde", "other"]}}
    },
    "items_answered": {"description": "Questionnaire item codes with a clear answer (denominator for that item).", "type": "array", "items": {"type": "string"}},
    "items_uncertain": {"description": "Questionnaire item codes answered Uncertain (not counted as positive).", "type": "array", "items": {"type": "string"}},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "description", "checkable", "verification"],
        "properties": {
          "claim_id": {"type": "string"},
          "type": {"enum": ["veridical_perception", "verifiable_fact", "prediction", "other"]},
          "description": {"type": "string"},
          "checkable": {"type": "boolean"},
          "verification": {
            "type": "object",
            "required": ["status", "evidence_type"],
            "properties": {
              "status": {"enum": ["confirmed", "refuted", "unverifiable", "not_attempted"]},
              "evidence_type": {"enum": ["independent_document", "independent_witness", "same_narrator_only", "none"]},
              "evidence_ref": {"type": ["string", "null"]},
              "checked_by": {"type": ["string", "null"]},
              "checked_at": {"type": ["string", "null"]},
              "note": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "medical_case": {
      "description": "Optional. Only for accounts that report a health outcome. Evidence status only, never advice.",
      "type": "object",
      "required": ["condition", "claimed_outcome", "documentation_level"],
      "properties": {
        "condition": {"type": "string"},
        "condition_category": {"enum": ["cancer", "cardiovascular", "neurological", "musculoskeletal", "infectious", "mental_health", "other"]},
        "stage_or_severity": {"type": ["string", "null"]},
        "diagnosis_basis": {"enum": ["histology", "imaging", "clinical", "unconfirmed", "unknown"]},
        "claimed_outcome": {"enum": ["remission", "recovery", "improvement", "no_change", "deterioration", "death", "unknown"]},
        "interventions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {"enum": ["conventional", "alternative", "mind_body", "spiritual_experience", "none", "unknown"]},
              "description": {"type": ["string", "null"]}
            }
          }
        },
        "conventional_treatment_concurrent": {"enum": ["yes", "no", "unknown"]},
        "documentation_level": {
          "description": "Ladder, lowest to highest. Counts are reported per level and never pooled across levels.",
          "enum": ["self_report", "interview", "clinician_statement", "records_seen_by_reviewer", "records_published", "independent_specialist_review", "published_case_report", "controlled_study"]
        },
        "follow_up_months": {"type": ["number", "null"]},
        "relapse": {"enum": ["yes", "no", "unknown"]},
        "how_case_came_to_attention": {"enum": ["self_selected", "media", "registry", "researcher_sampled", "unknown"]},
        "denominator_known": {"type": "boolean"},
        "reviewed_by_human": {"type": "boolean"}
      }
    },
    "coding": {
      "type": "object",
      "required": ["codebook_version", "coder_id", "coded_at"],
      "properties": {
        "codebook_version": {"type": "string"},
        "coder_id": {"type": "string"},
        "coded_at": {"type": "string"}
      }
    }
  }
}
